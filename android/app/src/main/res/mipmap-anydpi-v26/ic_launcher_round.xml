<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon. The foreground is the Tasvi mark, trimmed from the supplied
  art and inset to the 72dp safe zone so it survives any mask the launcher applies.
  The background is white, which is what the art was drawn on.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
