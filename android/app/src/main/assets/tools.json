    { "id": "autocolour", "name": "Auto colour",    "category": "colour", "icon": "chip",
      "purpose": "Fix a cast, lift a dull shot", "runner": "arithmetic", "ready": false },

    { "id": "colourmatch","name": "Colour match",   "category": "colour", "icon": "shield",
      "purpose": "Blend a face into its frame", "runner": "arithmetic", "ready": true },

    { "id": "filters",    "name": "Filters",        "category": "colour", "icon": "filter",
      "purpose": "Thirteen one-tap looks", "runner": "arithmetic", "ready": true },

    { "id": "relight",    "name": "Relight",        "category": "colour", "icon": "warmth",
      "purpose": "Fix harsh shadows on a portrait",
      "runner": "relight", "models": ["blazeedit"], "ready": false },

    { "id": "crop",       "name": "Crop and rotate","category": "transform", "icon": "crop",
      "purpose": "Frame it, level it", "runner": "arithmetic", "ready": true },

    { "id": "resize",     "name": "Resize",         "category": "transform", "icon": "cube",
      "purpose": "Exact pixel dimensions", "runner": "arithmetic", "ready": true },

    { "id": "straighten", "name": "Straighten",     "category": "transform", "icon": "sort",
      "purpose": "Level a tilted horizon", "runner": "arithmetic", "ready": true },

    { "id": "outpaint",   "name": "Extend",         "category": "transform", "icon": "grid2",
      "purpose": "Grow the frame — portrait to landscape",
      "runner": "outpaint", "models": ["blazeedit"], "ready": false },

    { "id": "reshape",    "name": "Reshape",        "category": "people", "icon": "sliders",
      "purpose": "Jaw, nose, waist, height", "runner": "arithmetic", "ready": false },

    { "id": "skin",       "name": "Skin",           "category": "people", "icon": "person",
      "purpose": "Smooth tone, keep texture", "runner": "arithmetic", "ready": false },

    { "id": "eyes",       "name": "Eyes",           "category": "people", "icon": "scan",
      "purpose": "Brighten and sharpen", "runner": "arithmetic", "ready": false },

    { "id": "teeth",      "name": "Teeth",          "category": "people", "icon": "star",
      "purpose": "Whiten, without going blue", "runner": "arithmetic", "ready": false },

    { "id": "faceswap",   "name": "Face swap",      "category": "people", "icon": "swap",
      "purpose": "One face onto another",
      "runner": "face_swap", "models": ["inswapper_128", "simswap_256", "ghost_2", "hififace", "facedancer"], "ready": true },

    { "id": "videoswap",  "name": "Swap a video",   "category": "video", "icon": "video",
      "purpose": "Frame by frame, audio kept",
      "runner": "video", "models": ["inswapper_128"], "ready": true },

    { "id": "videoupscale","name": "Video upscale","category": "video", "icon": "hd",
      "purpose": "Upscale a whole clip",
      "runner": "video", "models": ["real_esrgan_x4plus"], "ready": false },

    { "id": "gif",        "name": "GIF maker",      "category": "video", "icon": "gif",
      "purpose": "Turn frames into an animation", "runner": "gif", "ready": false }
