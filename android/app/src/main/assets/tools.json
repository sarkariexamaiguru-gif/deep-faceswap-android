{
  "version": 1,
  "note": "Every tool in Tasvi is defined here, not in code. Add an entry and the tool appears in the app. If it names a model, the app offers to download that model first; if the model is not installed the tool shows as 'Needs a model' rather than failing when tapped.",
  "runners": ["arithmetic", "upscale", "denoise", "dejpeg", "segment", "inpaint", "colourise", "deblur", "face_swap", "video", "gif", "relight", "outpaint", "tone"],

  "categories": [
    { "id": "enhance",  "name": "Enhance and restore", "icon": "hd" },
    { "id": "cleanup",  "name": "Cleanup",             "icon": "sparkle" },
    { "id": "cutout",   "name": "Cutout and background","icon": "scissors" },
    { "id": "colour",   "name": "Colour and style",    "icon": "palette" },
    { "id": "transform","name": "Transform",           "icon": "crop" },
    { "id": "people",   "name": "People",              "icon": "person" },
    { "id": "video",    "name": "Video and GIF",       "icon": "video" }
  ],

  "tools": [
    { "id": "edit",       "name": "Edit a photo",   "category": "transform", "icon": "sliders",
      "purpose": "Crop, light, colour, sharpen", "runner": "arithmetic", "screen": "EditActivity", "ready": true },

    { "id": "upscale",    "name": "Upscale",        "category": "enhance", "icon": "hd",
      "purpose": "Make an image larger without softening it",
      "runner": "upscale", "models": ["real_esrgan_x4plus", "span_kendata_x4", "swin2sr_x4", "realesr_general_x4v3", "quicksrnet_m", "esrgan"], "ready": true },

    { "id": "denoise",    "name": "Denoise",        "category": "enhance", "icon": "sparkle",
      "purpose": "Remove grain and phone noise",
      "runner": "denoise", "models": ["scunet", "nafnet_denoise", "realplksr_denoise", "dncnn"], "ready": true },

    { "id": "dejpeg",     "name": "De-JPEG",        "category": "enhance", "icon": "grid2",
      "purpose": "Erase blocking from compressed images",
      "runner": "dejpeg", "models": ["omnisr_dejpeg", "realplksr_dejpeg"], "ready": true },

    { "id": "deblur",     "name": "Remove blur",    "category": "enhance", "icon": "wave",
      "purpose": "Recover a soft or motion-blurred shot",
      "runner": "deblur", "models": ["nafnet_deblur"], "ready": false },

    { "id": "sharpen",    "name": "Sharpen",        "category": "enhance", "icon": "star",
      "purpose": "Crisper edges, colour untouched", "runner": "arithmetic", "ready": false },

    { "id": "restore",    "name": "Restore",        "category": "enhance", "icon": "star",
      "purpose": "Repair an old or degraded photograph",
      "runner": "upscale", "models": ["gpen_bfr_256", "gfpgan_14", "codeformer", "restoreformer_pp"], "ready": false },

    { "id": "erase",      "name": "Erase object",   "category": "cleanup", "icon": "erase",
      "purpose": "Paint something out and fill it in",
      "runner": "inpaint", "models": ["migan", "aotgan", "lama_dilated"],
      "params": [{ "key": "brush", "type": "slider", "min": 8, "max": 160, "default": 40 }], "ready": false },

    { "id": "colourise",  "name": "Colourise",      "category": "colour", "icon": "palette",
      "purpose": "Bring a black-and-white photo to colour",
      "runner": "colourise", "models": ["ddcolor_tiny", "ddcolor"], "ready": false },

    { "id": "cutout",     "name": "Cut out",        "category": "cutout", "icon": "scissors",
      "purpose": "Drop the background, keep the subject",
      "runner": "segment", "models": ["birefnet_lite_512", "mediapipe_selfie", "u2net", "mobilesam"], "ready": true },

    { "id": "swapbg",     "name": "Swap background","category": "cutout", "icon": "image",
      "purpose": "Put the subject somewhere else",
      "runner": "segment", "models": ["birefnet_lite_512", "mediapipe_selfie"], "ready": false },

    { "id": "select",     "name": "Select region",  "category": "cutout", "icon": "scan",
